datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  mobile       String       @unique
  password     String
  avatar       String?
  role         Role         @default(USER)
  status       UserStatus   @default(ACTIVE)
  sponsorId    String?
  sponsor      User?        @relation("SponsorRelation", fields: [sponsorId], references: [id])
  sponsored    User[]       @relation("SponsorRelation")
  
  // KYC Relation
  kyc          KYC?

  // Wallet Relation
  wallet       Wallet?

  // Orders
  orders       Order[]

  // Incomes earned
  incomes      Income[]     @relation("UserIncome")
  sourceIncomes Income[]    @relation("IncomeSourceUser")

  // Binary tree hierarchy
  binaryNode   BinaryNode?  @relation("UserBinaryNode")

  // Franchise info
  franchise    Franchise?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum Role {
  USER
  FRANCHISE
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

model KYC {
  id              String      @id @default(uuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  aadhaarNumber   String?
  panNumber       String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  status          KycStatus   @default(PENDING)
  verifiedAt      DateTime?
  rejectionReason String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum KycStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model Wallet {
  id               String        @id @default(uuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance          Decimal       @default(0.00) @db.Decimal(12, 2)
  totalEarnings    Decimal       @default(0.00) @db.Decimal(12, 2)
  totalWithdrawals Decimal       @default(0.00) @db.Decimal(12, 2)

  transactions     Transaction[]
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  description String
  status      TransactionStatus @default(PENDING)
  reference   String?

  createdAt   DateTime          @default(now())
}

enum TransactionType {
  CREDIT
  DEBIT
  WITHDRAWAL
  PAYOUT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Income {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation("UserIncome", fields: [userId], references: [id], onDelete: Cascade)
  fromUserId     String?
  fromUser       User?      @relation("IncomeSourceUser", fields: [fromUserId], references: [id])
  type           IncomeType
  amount         Decimal    @db.Decimal(12, 2)
  level          Int?
  description    String
  
  createdAt      DateTime   @default(now())
}

enum IncomeType {
  DIRECT
  BINARY
  MATCHING
  LEADERSHIP
  ROYALTY
  REWARD
  RETAIL_PROFIT
}

model BinaryNode {
  id          String      @id @default(uuid())
  userId      String      @unique
  user        User        @relation("UserBinaryNode", fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      BinaryNode? @relation("BinaryChildren", fields: [parentId], references: [id])
  children    BinaryNode[] @relation("BinaryChildren")
  position    Position?

  leftPV      Decimal     @default(0.00) @db.Decimal(12, 2)
  rightPV     Decimal     @default(0.00) @db.Decimal(12, 2)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum Position {
  LEFT
  RIGHT
}

model Product {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  description      String
  shortDescription String
  price            Decimal         @db.Decimal(10, 2)
  mrp              Decimal         @db.Decimal(10, 2)
  discount         Decimal         @default(0.00) @db.Decimal(5, 2)
  pv               Decimal         @db.Decimal(10, 2) // Point Value
  bv               Decimal         @db.Decimal(10, 2) // Business Volume
  category         String
  images           String[]
  inStock          Boolean         @default(true)
  stockQuantity    Int             @default(0)
  
  orderItems       OrderItem[]
  franchiseItems   FranchiseItem[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  totalAmount    Decimal     @db.Decimal(12, 2)
  totalPV        Decimal     @db.Decimal(12, 2)
  status         OrderStatus @default(PENDING)
  paymentStatus  String      @default("PENDING")
  street         String
  city           String
  state          String
  pincode        String
  country        String

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  price       Decimal  @db.Decimal(10, 2)
  pv          Decimal  @db.Decimal(10, 2)
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model Franchise {
  id             String          @id @default(uuid())
  name           String
  ownerId        String          @unique
  user           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type           FranchiseType   @default(STANDARD)
  territory      String
  status         FranchiseStatus @default(PENDING)
  investment     Decimal         @db.Decimal(12, 2)
  
  inventory      FranchiseItem[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum FranchiseType {
  MICRO
  MINI
  STANDARD
  PREMIUM
  MEGA
}

enum FranchiseStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

model FranchiseItem {
  id          String    @id @default(uuid())
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([franchiseId, productId])
}
